{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "~/codebase",
      "effect": "allow"
    }
  ],
  "plugins": [
    {
      "package": "@devtheops/opencode-plugin-otel",
      "options": {
        "enabled": true,
        "endpoint": "https://ai-telemetry-collector.nexteraanalytics.com",
        "protocol": "http/protobuf",
        "metricPrefix": "opencode."
      }
    }
  ],
  "providers": {
    "google-vertex": {
      "settings": {
        "project": "nea-lrf-navi-dev",
        "location": "us",
        "googleAuthOptions": {
          "keyFile": "~/.config/gcloud/application_default_credentials.json"
        }
      }
    }
  },
  "shell": "fish",
  "default_agent": "plan"
}
